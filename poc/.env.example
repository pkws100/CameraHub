CAMERA_HUB_DISCOVERY_NETWORK=192.168.1.0/24
CAMERA_HUB_TRUSTED_PROXY_NETWORKS=172.28.178.0/24
CAMERA_HUB_PRIVATE_HTTP_NETWORKS=192.168.1.0/24

# Optionaler Rollbackpfad für bereits vorhandene statische Relays.
# Standardmäßig bleibt dieses Profil aus; neue Kameras werden in der App verwaltet.
# COMPOSE_PROFILES=legacy-static
# Garten besitzt nach der dynamischen Migration ein getrenntes, nur für einen
# kontrollierten Rollback vorgesehenes Profil:
# COMPOSE_PROFILES=legacy-static,legacy-static-garten
# CAMERA_GARTEN_SOURCE_URI=rtsp://camera.example.invalid/live
# CAMERA_EINGANG_SOURCE_URI=rtsp://camera.example.invalid/live
# CAMERA_SERVERRAUM_SOURCE_URI=rtsp://camera.example.invalid/live
# CAMERA_RUECKSEITE_SOURCE_URI=rtsp://camera.example.invalid/live
# CAMERA_EINFAHRT_SOURCE_URI=rtsp://camera.example.invalid/live
# CAMERA_GARAGE_SOURCE_URI=rtsp://recorder.example.invalid/live
#
# Wird vom Startskript anhand der lokalen SOURCE_URI-Werte abgeleitet.
# Enthält nur neutrale Kamera-IDs, niemals Zugangsdaten oder Streamadressen.
# CAMERA_HUB_STATIC_AUTHENTICATED_IDS=garten,garage

# Kamera-Zugangsdaten gehören ausschließlich in die verschlüsselte
# Kameraverwaltung. Die Anwendungsschlüssel erzeugt das Startskript lokal
# unter poc/runtime/secrets/; dieses Verzeichnis wird nicht versioniert.
